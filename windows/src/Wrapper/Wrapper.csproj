<Project Sdk="Microsoft.NET.Sdk">
  <!-- One exe, copied as claude.exe and claude-as.exe. It reads names and default, never JSON. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>claude</AssemblyName>
    <RootNamespace>Wrapper</RootNamespace>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OptimizationPreference>Speed</OptimizationPreference>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StackTraceSupport>false</StackTraceSupport>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
