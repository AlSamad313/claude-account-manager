<ui:FlowBase x:Class="ProfileUI.DoctorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ProfileUI">
    <ui:FlowBase.Resources>
        <ResourceDictionary Source="/ProfileUI;component/Theme.xaml" />
    </ui:FlowBase.Resources>
    <StackPanel>
        <TextBlock Text="Doctor" Style="{StaticResource FlowTitle}" />
        <ProgressBar x:Name="Running" IsIndeterminate="True" Height="4" Margin="0,8" />
        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Findings">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Icon}" Foreground="{Binding Brush}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       AutomationProperties.Name="{Binding Level}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Message}" Style="{StaticResource Wrapped}" />
                                <TextBox Text="{Binding Fix, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                         FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                         Visibility="{Binding Fix, Converter={StaticResource Shown}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <DockPanel Margin="0,12,0,0">
            <Button x:Name="RepairButton" Content="Repair files" Style="{StaticResource DialogButton}" Margin="0" Click="Repair"
                    ToolTip="Rewrites default and names from the profile list" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Done" IsDefault="True" IsCancel="True" Style="{DynamicResource AccentButtonStyle}" MinWidth="88" Click="Home" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</ui:FlowBase>
