<ui:FlowBase x:Class="ProfileUI.CopySetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ProfileUI">
    <ui:FlowBase.Resources>
        <ResourceDictionary Source="/ProfileUI;component/Theme.xaml" />
    </ui:FlowBase.Resources>
    <StackPanel>
        <TextBlock Text="Copy setup" Style="{StaticResource FlowTitle}" />

        <StackPanel x:Name="NoTargets">
            <TextBlock Style="{StaticResource Wrapped}"
                       Text="Add and sign in to another profile first. The built-in profile can be copied from, never into." />
            <StackPanel Style="{StaticResource ButtonRow}">
                <Button Content="Done" IsDefault="True" IsCancel="True" Style="{StaticResource DialogButton}" Click="Home" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="Copying">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="FromBox" Grid.Column="1" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                          AutomationProperties.Name="From" SelectionChanged="FromChanged" />
                <TextBlock Grid.Column="2" Text="To" VerticalAlignment="Center" Margin="10,0,6,0" />
                <ComboBox x:Name="ToBox" Grid.Column="3" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                          AutomationProperties.Name="To" SelectionChanged="ToChanged" />
            </Grid>

            <Border x:Name="BlockedBox" Style="{StaticResource Critical}" Margin="0,10,0,0">
                <TextBlock x:Name="BlockedText" Style="{StaticResource Wrapped}" />
            </Border>
            <Border x:Name="ResultBox" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock x:Name="ResultText" Style="{StaticResource Wrapped}" />
                    <StackPanel x:Name="Removals" Margin="0,6,0,0">
                        <TextBlock Style="{StaticResource Wrapped}" FontSize="12"
                                   Text="Installed by Claude Code, so Restore cannot undo these. To remove, run:" />
                        <TextBox x:Name="RemovalText" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap"
                                 Margin="0,4,0,0" AutomationProperties.Name="Commands to remove" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ProgressBar x:Name="Loading" IsIndeterminate="True" Height="4" Margin="0,10" />
            <TextBlock x:Name="NothingText" Style="{StaticResource Wrapped}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,10,0,0" />
            <StackPanel x:Name="Groups" Margin="0,4,0,0" />

            <TextBlock x:Name="AccountNote" Style="{StaticResource Wrapped}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,12,0,0" />

            <DockPanel Margin="0,12,0,0">
                <Button x:Name="RestoreButton" Content="Restore…" Style="{StaticResource DialogButton}" Margin="0" Click="OpenRestore"
                        ToolTip="Undo an earlier copy into this profile">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="RestoreMenu" />
                    </Button.ContextMenu>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ApplyButton" Style="{DynamicResource AccentButtonStyle}" MinWidth="88" Click="Apply" />
                    <Button Content="Done" IsCancel="True" Style="{StaticResource DialogButton}" Click="Done" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </StackPanel>
</ui:FlowBase>
