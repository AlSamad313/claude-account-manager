<UserControl x:Class="ProfileUI.MessageBanners"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="/ProfileUI;component/Theme.xaml" />
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource Critical}" Visibility="{Binding ErrorText, Converter={StaticResource Shown}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Click="DismissError" AutomationProperties.Name="Dismiss" VerticalAlignment="Top" />
                <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Wrapped}" Margin="0,0,8,0" />
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Caution}" Visibility="{Binding NoticeText, Converter={StaticResource Shown}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Click="DismissNotice" AutomationProperties.Name="Dismiss" VerticalAlignment="Top" />
                <TextBlock Text="{Binding NoticeText}" Style="{StaticResource Wrapped}" Margin="0,0,8,0" />
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Caution}" Visibility="{Binding MissingFolderText, Converter={StaticResource Shown}}">
            <StackPanel>
                <TextBlock Text="{Binding MissingFolderText}" Style="{StaticResource Wrapped}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Choose folder…" Style="{StaticResource Small}" Margin="0" Click="ChooseFolder" />
                    <Button Content="Cancel" Style="{StaticResource Small}" Click="CancelFolder" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
