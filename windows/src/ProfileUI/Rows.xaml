<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:ProfileUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ProfileUI;component/Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="ProfileRow" DataType="{x:Type ui:ProfileItem}">
        <Grid Margin="6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Style="{StaticResource Dot}" Fill="{Binding Color, Converter={StaticResource HexToBrush}}" />
            <StackPanel Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Border Margin="6,0,0,0" Padding="5,0" CornerRadius="4" VerticalAlignment="Center"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            Visibility="{Binding IsDefault, Converter={StaticResource Shown}}">
                        <TextBlock Text="DEFAULT" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Finish sign-in" Style="{StaticResource Small}" Command="{Binding FinishSignIn}"
                        Visibility="{Binding IsPending, Converter={StaticResource Shown}}" />
                <Button Content="Sign in" Style="{StaticResource Small}" Command="{Binding SignIn}" IsEnabled="{Binding ShellInstalled}"
                        Visibility="{Binding IsLoggedOut, Converter={StaticResource Shown}}" />
                <TextBlock VerticalAlignment="Center" FontSize="12" Margin="4,0"
                           Visibility="{Binding ShowMakeDefault, Converter={StaticResource Shown}}">
                    <Hyperlink Command="{Binding MakeDefault}">Make default</Hyperlink>
                </TextBlock>
                <Button Content="New Terminal" Style="{StaticResource Small}" Command="{Binding NewTerminal}" IsEnabled="{Binding ShellInstalled}"
                        Visibility="{Binding IsUsable, Converter={StaticResource Shown}}"
                        ToolTipService.ShowOnDisabled="True" ToolTip="Opens a terminal window running claude on this profile" />
                <Menu Background="Transparent" VerticalAlignment="Center" Margin="2,0,0,0">
                    <MenuItem Header="⋯" Padding="8,2" AutomationProperties.Name="{Binding Name, StringFormat='More for {0}'}">
                        <MenuItem Header="Open VS Code" Command="{Binding OpenVSCode}" />
                        <MenuItem Header="Settings…" Command="{Binding Settings}" />
                    </MenuItem>
                </Menu>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SessionRow" DataType="{x:Type ui:SessionItem}">
        <Grid Margin="6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Style="{StaticResource Dot}" Width="8" Height="8" Fill="{Binding Color, Converter={StaticResource HexToBrush}}" />
            <StackPanel Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" ToolTip="{Binding Folder}" />
            </StackPanel>
            <!-- A live row shows Stop only, and any other row shows Resume only. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Stop" Style="{StaticResource Small}" Command="{Binding Stop}"
                        Visibility="{Binding IsLive, Converter={StaticResource Shown}}" />
                <Button Content="Resume" Style="{StaticResource Small}" Command="{Binding Resume}" IsEnabled="{Binding ShellInstalled}"
                        Visibility="{Binding IsLive, Converter={StaticResource Shown}, ConverterParameter=Invert}" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
