<ui:FlowBase x:Class="ProfileUI.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ProfileUI">
    <ui:FlowBase.Resources>
        <ResourceDictionary Source="/ProfileUI;component/Theme.xaml" />
    </ui:FlowBase.Resources>
    <StackPanel>
        <TextBlock Text="Profile settings" Style="{StaticResource FlowTitle}" />
        <StackPanel x:Name="Body">
            <TextBlock Text="Display name" FontSize="12" Margin="0,8,0,4" />
            <TextBox x:Name="NameBox" AutomationProperties.Name="Display name" KeyDown="NameKey" />
            <TextBlock Text="Colour" FontSize="12" Margin="0,10,0,6" />
            <ui:Swatches x:Name="ColorPicker" />
            <TextBlock x:Name="CommandText" Style="{StaticResource Wrapped}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,10,0,0" />
            <TextBlock x:Name="AccountText" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
            <TextBlock x:Name="BuiltinText" Style="{StaticResource Wrapped}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0"
                       Text="This is your existing .claude folder. The app never writes to it, so it has no status line and cannot be removed." />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="VSCodeButton" Style="{StaticResource Small}" Margin="0" Click="OpenVSCode" />
                <Button x:Name="DefaultButton" Content="Make default" Style="{StaticResource Small}" Click="MakeDefault" />
            </StackPanel>
            <TextBlock Style="{StaticResource Wrapped}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0"
                       Text="Quit VS Code first if it is running. Opened from the Start menu, it uses the built-in profile." />
            <StackPanel Style="{StaticResource ButtonRow}">
                <Button x:Name="RemoveButton" Content="Remove…" Style="{StaticResource DialogButton}" Click="Remove" />
                <Button Content="Done" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" MinWidth="88" Click="Done" />
            </StackPanel>
        </StackPanel>
        <StackPanel x:Name="Gone">
            <TextBlock Text="That profile is gone." />
            <StackPanel Style="{StaticResource ButtonRow}">
                <Button Content="Done" IsDefault="True" Style="{StaticResource DialogButton}" Click="Home" />
            </StackPanel>
        </StackPanel>
        <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Error}" Margin="0,10,0,0"
                   Visibility="{Binding ErrorText, Converter={StaticResource Shown}}" />
    </StackPanel>
</ui:FlowBase>
