#!/bin/zsh
# Claude Code status line command for an added profile. Takes a profile ID.
# Prints nothing for an unknown ID.
names="$HOME/.claude-profiles/names"
[[ -r $names ]] || exit 0
while IFS=$'\t' read -r cmd id disp color dir; do
  [[ $id == "$1" ]] || continue
  hex=${color#\#}
  printf '\033[38;2;%d;%d;%dm●\033[0m %s\n' 0x${hex[1,2]} 0x${hex[3,4]} 0x${hex[5,6]} "$disp"
  exit 0
done < "$names"
